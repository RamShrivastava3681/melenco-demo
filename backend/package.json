{
  "name": "ledgerly-backend",
  "private": true,
  "type": "module",
  "vitest": {
    "test": {
      "include": [
        "tests/**/*.test.ts"
      ],
      "setupFiles": [
        "tests/setup.ts"
      ],
      "testTimeout": 30000,
      "pool": "forks",
      "poolOptions": {
        "forks": {
          "singleFork": true
        }
      }
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.1147.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.0",
    "xero-node": "^18.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.16.5",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.1"
  }
}
