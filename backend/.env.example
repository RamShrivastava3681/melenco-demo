# ── Development ────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Production ──────────────────────────────────
# PORT=3004
# NODE_ENV=production
# FRONTEND_URL=https://excel.frillchills.com

# ── Tally API (connector) ──
# Canonical public base URL the desktop connector talks to (outbound HTTPS).
# Never point connectors at localhost — this is the URL, not the default.
PUBLIC_API_BASE_URL=https://excel.frillchills.com/api

# ── JWT Secret (REQUIRED — change in production!) ─
JWT_SECRET=change-me-to-a-random-secret-in-production

# ── Database (DynamoDB single-table) ────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Full DynamoDB table name (single table with pk + sk keys)
DYNAMODB_TABLE_PREFIX=mickey-mouse
# Optional: local endpoint for dev (e.g. DynamoDB Local)
# DYNAMODB_ENDPOINT=http://localhost:8000
# Tests use an in-memory store automatically (no AWS needed)
# USE_MEMORY_DB=1
