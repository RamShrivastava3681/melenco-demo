# ── Development ────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Production ──────────────────────────────────
# PORT=3004
# NODE_ENV=production
# FRONTEND_URL=https://excel.frillchills.com

# ── WhizUnik Cloud API (TallyPrime connector) ──
# Canonical public base URL the desktop connector talks to (outbound HTTPS).
# Never point connectors at localhost — this is the URL, not the default.
PUBLIC_API_BASE_URL=https://api.whizunik.com

# ── JWT Secret (REQUIRED — change in production!) ─
JWT_SECRET=change-me-to-a-random-secret-in-production

# ── Database (SQLite) ───────────────────────────
DATABASE_URL=./data/ledgerly.db
